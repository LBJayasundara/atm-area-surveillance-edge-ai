rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Alerts collection — authenticated users can read and create;
    // updates are restricted to the acknowledged/acknowledged_at fields only;
    // deletion is not permitted.
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['acknowledged', 'acknowledged_at']);
      allow delete: if false;
    }

    // System statistics — readable by authenticated users; written only by
    // the server-side Admin SDK (Raspberry Pi / Cloud Functions).
    match /system_stats/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
